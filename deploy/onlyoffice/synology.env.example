# Add these entries to your EXISTING private deployment environment file.
# Do not replace your database/application secrets or change existing file roots.
EAC_BACKEND_SOURCE=/REPLACE_WITH_EXISTING_BACKEND_CHECKOUT
EAC_FILES_ROOT=/REPLACE_WITH_EXISTING_CANONICAL_FILES_DIRECTORY
EAC_FILE_BACKUPS_ROOT=/REPLACE_WITH_EXISTING_FILE_BACKUP_DIRECTORY
EAC_FRONTEND_URL=https://eac-system.eaconcept.org
# Suggested new Office subdomain: office.eaconcept.org (DNS/TLS/proxy must be configured first).
EAC_ONLYOFFICE_PUBLIC_URL=https://office.eaconcept.org
EAC_ONLYOFFICE_LOCAL_PORT=8082
# Required: supply a separate random secret of at least 32 bytes in the private deployment environment.
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PROTECTED_RANGES_VERIFIED=false


# Generate once, preserve across restarts and keep separately from DB backups and Git.
APP_FILES_PASSWORD_KEY=
