# Copy to .env.local. Never commit .env.local.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/eac_attendance
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-password
# Generate a long random signing secret; keep it stable across local restarts.
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long
SPRING_LIQUIBASE_ENABLED=false
SPRING_MAIL_PASSWORD=local-mail-not-configured
APP_FILES_STORAGE_ROOT=./uploads/file-suite
APP_FILES_BACKUP_ROOT=./backups/file-suite
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_FILES_COLLABORATION_KEY=replace-with-the-same-random-48-byte-key-as-the-collaboration-server

# Lightweight local mode by default; configure a separate Docs server for native editing.
ONLYOFFICE_ENABLED=false

# Generate once, preserve across restarts and keep separately from DB backups and Git.
APP_FILES_PASSWORD_KEY=replace-with-a-separate-random-secret-of-at-least-32-characters
